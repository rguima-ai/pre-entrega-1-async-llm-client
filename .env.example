# Copiá este archivo a .env y completá tus keys. El .env nunca se sube a GitHub.

# Proveedor por defecto: openai | anthropic
LLM_PROVIDER=openai
# Proveedor de respaldo si el principal falla (vacío = sin fallback). Necesita su propia key.
LLM_FALLBACK_PROVIDER=anthropic

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales (estos son los valores por defecto)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LOG_LEVEL=INFO
